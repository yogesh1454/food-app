# This tells Lombok that this is the root directory and that it shouldn't search parent directories for more configuration files
config.stopBubbling = true

# Generate @lombok.Generated on all generated methods
lombok.addLombokGeneratedAnnotation = true

# Copy these annotations to the constructor's parameters
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy

# Additional Lombok configuration
lombok.accessors.chain = true
lombok.fieldDefaults.defaultPrivate = true
lombok.fieldDefaults.defaultFinal = false

# Equalsandhashcode configuration
lombok.equalsAndHashCode.callSuper = call
lombok.toString.callSuper = call

# Experimental features
lombok.experimental.flagUsage = error 