# Tea & Snacks Delivery Aggregator Environment Configuration
# Copy this file to .env and update values as needed

# Database Configuration
POSTGRES_DB=tea_snacks_db
POSTGRES_USER=tea_snacks_user
POSTGRES_PASSWORD=tea_snacks_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ZOOKEEPER_HOST=localhost:2181

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# Application Configuration
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Monitoring Configuration
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090
GRAFANA_HOST=localhost
GRAFANA_PORT=3000

# Kafka UI Configuration
KAFKA_UI_HOST=localhost
KAFKA_UI_PORT=8080

# Logging Configuration
LOG_LEVEL=INFO
LOG_PATTERN=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# Development Configuration
DEBUG=true
HOT_RELOAD=true 